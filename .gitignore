# --- dataset (never committed; read-only for code) ---
mafaulda/
archive.zip

# --- derived data, caches, weights ---
SystemCode/data/*
!SystemCode/data/.gitkeep
*.npy
**/*.pt
**/artifacts/**/*.pt
**/artifacts/**/gpu.lock
*.safetensors
# the committed demo pack (5 development recordings + their healthy references; scripts/40_demo_pack.py)
!SystemCode/demo/raw_npy/*.npy
# the approved model bundle (about 4 MB) is committed so a fresh clone runs the app; its manifest pins every file's sha256
!SystemCode/artifacts/bundle/*.safetensors

# --- experiment tracking ---
mlruns.db
mlruns/

# --- environments and secrets ---
.venv/
.env

# --- frontend (commit dist/ only for a release) ---
node_modules/
**/frontend/dist/

# --- Python / tooling noise ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# --- derived model outputs (reproducible with scripts/05_baselines.py) ---
SystemCode/results/scores/

# --- deployable model bundle (Stage ML-4; rebuilt by scripts/14_train_bundle.py): committed since the demo-pack release ---

# --- app runtime state (Stage App-2a): case history, uploaded arrays, reserved-fingerprint index, showcase sweep ---
SystemCode/backend/data/*
# committed: the files the app needs at startup in a clone without the raw recordings (both would otherwise be rebuilt
# from data/raw_npy): the reserved-recording upload guard (fingerprints only) and the typical healthy variation
!SystemCode/backend/data/reserved_fingerprints.json
!SystemCode/backend/data/healthy_variation.json
